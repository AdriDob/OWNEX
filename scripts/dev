#!/usr/bin/env python3
"""OWNEX `dev` — single dev-tool entrypoint.

Usage:
    .venv/bin/python scripts/dev <command> [-- <extra args>]

Commands (forward to the configured tool in .venv):
    lint        ruff check + format --check
    fmt         ruff check --fix && ruff format  (write)
    typecheck   mypy over cores/ core/ api/ database/ desktop/
    test        pytest (excludes test_security.py by default)
    coverage    pytest --cov=cores,core
    test-fast   smoke subset: scoring, opportunity, scheduler
    check       lint + typecheck + test-fast (pre-flight)
    work        agent startup protocol
    status      agent startup --no-tests
    help        print this message

The wrapper always uses the interpreter that launched it (``sys.executable``)
so it works inside ``.venv`` or a frozen env without modification.
"""

from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PY = sys.executable

DEFAULT_TEST_ARGS = [
    "--timeout=60",
    "-q",
    "--ignore=tests/test_security.py",
]

TEST_TARGETS = [
    "tests/test_scoring.py",
    "tests/test_opportunity_engine.py",
    "tests/test_opportunity_engine_comprehensive.py",
    "tests/test_scheduler_jobs.py",
    "tests/test_e2e_security_pipeline.py",
    "tests/test_security_cycle.py",
]


def _run(label: str, cmd: list[str]) -> int:
    print(f"▶ {label}: {' '.join(cmd)}")
    return subprocess.call(cmd, cwd=str(ROOT))


def cmd_lint(extra: list[str]) -> int:
    base = [PY, "-m", "ruff", "check", "."]
    rc = _run("ruff check", base + extra)
    if rc:
        return rc
    return _run("ruff format --check", [PY, "-m", "ruff", "format", "--check", "."] + extra)


def cmd_fmt(extra: list[str]) -> int:
    _run("ruff check --fix", [PY, "-m", "ruff", "check", "--fix", "."] + extra)
    return _run("ruff format", [PY, "-m", "ruff", "format", "."] + extra)


def cmd_typecheck(extra: list[str]) -> int:
    return _run(
        "mypy (full)",
        [PY, "-m", "mypy", "cores/", "core/", "api/", "database/", "desktop/"] + extra,
    )


def cmd_typecheck_fast(_extra: list[str]) -> int:
    return _run(
        "mypy (scoped)",
        [PY, "-m", "mypy", "core/opportunity/scoring.py",
         "core/scheduler/scheduler.py", "core/scheduler/jobs.py"],
    )


def cmd_test(extra: list[str]) -> int:
    args = DEFAULT_TEST_ARGS + extra
    if not extra and "--" not in sys.argv:
        args += ["tests/"]
    else:
        args += ["tests/"]
    return _run("pytest", [PY, "-m", "pytest", *args])


def cmd_coverage(extra: list[str]) -> int:
    return _run(
        "pytest --cov",
        [PY, "-m", "pytest", "--cov=cores", "--cov=core",
         "--cov-report=term-missing:skip-covered", *DEFAULT_TEST_ARGS, "tests/"] + extra,
    )


def cmd_test_fast(_extra: list[str]) -> int:
    # test_full_scoring_workflow is excluded: its mock side_effect sequence
    # (3 items) cannot satisfy the real on_accept/on_reject DB lookups.
    return _run(
        "pytest (fast)",
        [PY, "-m", "pytest", "--timeout=30", "-q",
         "--deselect", "tests/test_opportunity_engine_comprehensive.py::TestIntegrationScenarios::test_full_scoring_workflow",
         *TEST_TARGETS],
    )


def cmd_check(_extra: list[str]) -> int:
    for cmd in (cmd_typecheck_fast, cmd_test_fast):
        rc = cmd([])
        if rc:
            return rc
    print("✓ dev check passed: scoped typecheck + fast tests")
    return 0


def cmd_work(_extra: list[str]) -> int:
    return _run("agent-startup", [PY, "scripts/agent-startup.py"])


def cmd_status(_extra: list[str]) -> int:
    return _run("agent-startup --no-tests", [PY, "scripts/agent-startup.py", "--no-tests"])


COMMANDS = {
    "lint": cmd_lint,
    "fmt": cmd_fmt,
    "typecheck": cmd_typecheck,
    "typecheck-fast": cmd_typecheck_fast,
    "test": cmd_test,
    "coverage": cmd_coverage,
    "test-fast": cmd_test_fast,
    "check": cmd_check,
    "typecheck-fast": cmd_typecheck_fast,
    "work": cmd_work,
    "status": cmd_status,
}


def main() -> int:
    args = sys.argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        print(__doc__)
        print("Available commands:")
        for name in COMMANDS:
            print(f"  {name}")
        return 0

    name = args[0]
    extra = args[1:]
    if name not in COMMANDS:
        print(f"Unknown command: {name}", file=sys.stderr)
        print("Run '.venv/bin/python scripts/dev help' for the command list.", file=sys.stderr)
        return 2

    if shutil.which("ruff") is None and name in {"lint", "fmt"}:
        subprocess.call([PY, "-m", "pip", "install", "-q", "ruff"], cwd=str(ROOT))

    return COMMANDS[name](extra)


if __name__ == "__main__":
    sys.exit(main())
