# OWNEX v7.0.0 Configuration
ENVIRONMENT=development
DATABASE_URL=sqlite:///./ownex.db
LOG_LEVEL=INFO
ENABLE_SENSORS=true
ENABLE_PLAYWRIGHT=true
PORT=8000

# AI Provider Configuration
AI_PROVIDER=devin
DEVIN_PATH=devin
DEVIN_MODEL=default

# Alternative Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=freehuntx/qwen3-coder:8b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# FCC Proxy Configuration
ANTHROPIC_API_KEY=orion-dev-local
ANTHROPIC_BASE_URL=http://localhost:8082

# NVIDIA NIM Configuration
NVIDIA_API_KEY=your_nvidia_api_key_here
NIM_API_KEY=your_nim_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Cerebras (free tier — ultra-fast inference, llama3.1-70b)
# Get key at: https://cloud.cerebras.ai
# OAR adapter: cores/ai/runtime/adapters.py → create_cerebras_adapter()
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Supabase Configuration (Cloud Sync)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here
# Outlook / Microsoft Graph (calendar sync + Microsoft To Do + email notifications)
# App registration in Azure AD (Microsoft Entra ID) with Graph API permissions:
#   - Mail.Send, Calendars.ReadWrite, Mail.Read, Tasks.ReadWrite
# Personal Outlook accounts need an app-only setup; see docs/API_SETUP_GUIDE.md
CATEYE_OUTLOOK_CLIENT_ID=your_azure_app_client_id_here
CATEYE_OUTLOOK_CLIENT_SECRET=your_azure_app_client_secret_here
CATEYE_OUTLOOK_TENANT_ID=your_azure_tenant_id_here
# Email that receives OWNEX notification emails (usually your own mailbox)
CATEYE_OUTLOOK_NOTIFICATION_TO=you@outlook.com
