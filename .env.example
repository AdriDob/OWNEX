# CATEYE — Environment Configuration
# Copy to .env and adjust values.

# Authentication secret (auto-generated if not set)
CATEYE_AUTH_SECRET=

# ── AI Providers (checked in order) ──

# 1. Google Gemini via AI Studio (recommended — free tier available)
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. Ollama (local, fully offline)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=freehuntx/qwen3-coder:8b

# 3. OpenAI API (fallback when no other provider works)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Database ──
# DATABASE_URL=sqlite:///./database/catseye.db

# ── OSINT API Keys (optional — enable external threat intelligence) ──
SHODAN_API_KEY=
CENSYS_API_KEY=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
ALIENVAULT_OTX_KEY=
URLSCAN_API_KEY=
HUNTER_API_KEY=
BUILTWITH_API_KEY=
HIBP_API_KEY=
GREYNOISE_API_KEY=
INTELX_API_KEY=
PULSEDIVE_API_KEY=
IPINFO_API_KEY=

# ── Notification Channels ──

# Email (SMTP)
CATEYE_SMTP_HOST=
CATEYE_SMTP_PORT=587
CATEYE_SMTP_USER=
CATEYE_SMTP_PASSWORD=
CATEYE_SMTP_FROM=CATEYE@localhost
CATEYE_NOTIFICATION_EMAIL=

# FCM (Firebase Cloud Messaging)
CATEYE_FCM_SERVER_KEY=
CATEYE_FCM_PROJECT_ID=

# WhatsApp (Twilio)
CATEYE_TWILIO_ACCOUNT_SID=
CATEYE_TWILIO_AUTH_TOKEN=
CATEYE_TWILIO_WHATSAPP_FROM=14155238886
CATEYE_NOTIFICATION_WHATSAPP_TO=

# Gmail (OAuth2)
CATEYE_GMAIL_CLIENT_ID=
CATEYE_GMAIL_CLIENT_SECRET=
CATEYE_GMAIL_REFRESH_TOKEN=
CATEYE_GMAIL_FROM=

# ── Scan interval ──
CATEYE_SCAN_INTERVAL=30
