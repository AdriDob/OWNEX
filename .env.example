# Rastro / ORION — Environment Configuration
# Copy to .env and adjust values.

# Authentication secret (auto-generated if not set)
RASTRO_AUTH_SECRET=

# ── AI Providers (checked in order) ──

# 1. Google Gemini via AI Studio (recommended — free tier available)
# Get a free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 2. Ollama (local, fully offline)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# 3. OpenAI API (fallback when no other provider works)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Database ──
# DATABASE_URL=sqlite:///./database/rastro.db

# ── Scan interval ──
RASTRO_SCAN_INTERVAL=30
