    classDef l1 fill:#08090A,stroke:#5E6AD2,stroke-width:2px,color:#F6F8FB
    classDef l2 fill:#111113,stroke:#00E39A,stroke-width:2px,color:#F6F8FB
    classDef l3 fill:#1F2023,stroke:#FFB020,stroke-width:2px,color:#F6F8FB
    classDef l4 fill:#1F2023,stroke:#FFB020,stroke-width:1.5px,color:#F6F8FB
    classDef l5 fill:#2A2D35,stroke:#5E6AD2,stroke-width:1.5px,color:#F6F8FB
    classDef l6 fill:#111113,stroke:#FF5252,stroke-width:2px,color:#F6F8FB
    classDef l7 fill:#1F2023,stroke:#00E39A,stroke-width:1.5px,color:#F6F8FB

    class L1_EB,L1_SC,L1_UM,L1_SL,L1_CFG,L1_LOG l1
    class L2_MERLIN,L2_EVOL,L2_RECOVERY,L2_KM l2
    class L3_ORCH,L3_AB,L3_REG l3
    class L4_ENG,L4_QUA,L4_SEC,L4_REV l4
    class L5_FORGE,L5_PULSE,L5_SEC,L5_VAULT,L5_ATLAS,L5_ODYSSEY l5
    class L6_WF,L6_EX,L6_PC l6
    class L7_FM,L7_RM,L7_PL l7