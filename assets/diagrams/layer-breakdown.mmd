  init: {
    'theme': 'base',
    'themeVariables': {
      'primaryColor': '#111113',
      'primaryTextColor': '#F6F8FB',
      'primaryBorderColor': '#5E6AD2',
      'lineColor': '#5E6AD2',
      'secondaryColor': '#1F2023',
      'tertiaryColor': '#2A2D35',
      'background': 'transparent',
      'mainBkg': 'transparent',
