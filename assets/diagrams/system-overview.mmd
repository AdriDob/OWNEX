%% OWNEX System Architecture Overview
%% Rendered in README.md and docs/ARCHITECTURE.md

%%{
  init: {
    'theme': 'base',
    'themeVariables': {
      'primaryColor': '#0a0a0a',
      'primaryTextColor': '#f5f5f5',
      'primaryBorderColor': '#2e2e2e',
      'lineColor': '#2e2e2e',
      'secondaryColor': '#141414',
      'tertiaryColor': '#1f1f1f',
      'background': 'transparent',
      'mainBkg': 'transparent',
      'fontFamily': 'Inter',
      'fontSize': '14px',
      'edgeLabelBackground': '#000000',
      'clusterBkg': '#0a0a0a',
      'clusterBorder': '#2e2e2e'
    }
  }
}%%

graph TB
    %% HUMAN LAYER
    subgraph HUMAN ["Human Operator"]
        direction TB
        H_DIR[Strategic Direction]
        H_APPR[Approval Gates]
        H_FEED[Feedback / Correction]
    end

    %% OWNEX CORE
    subgraph CORE ["OWNEX Core"]
        direction TB
        EB[Event Bus<br/>cores.events]
        SC[Scheduler<br/>core.scheduler]
        UM[Unified Memory<br/>SQLite Namespaced]
        SL[Security Layer<br/>IdentityVault / Credentials]
        CFG[Configuration<br/>Environment / Secrets]
    end

    %% INTELLIGENCE LAYER
    subgraph INTEL ["Intelligence Layer"]
        direction TB
        MERLIN[MERLIN Assistant<br/>Persistent Memory + Actions]
        EVOL[Evolution Engine<br/>Self-Improvement / Rollback]
        RECOVERY[Recovery Engine<br/>Auto-Remediation]
        KM[Knowledge Capture<br/>Outcome Recording]
    end

    %% AGENT DEPARTMENTS
    subgraph DEPTS ["Agent Departments"]
        direction TB
        ORCH[Orchestrator<br/>Task Planning / Delegation]
        ENG[Engineering Agents<br/>Code / Build / Test]
        QUA[Quality Agents<br/>Review / Validate / Audit]
        SEC[Security Agents<br/>Recon / Exploit / Report]
        REV[Revenue Agents<br/>Track / Optimize / Report]
    end

    %% WORK CYCLES
    subgraph CYCLES ["Work Cycles"]
        direction TB
        FORGE[FORGE<br/>Dev Bounties / Freelance]
        PULSE[PULSE<br/>Data Annotation / Microtasks]
        SEC_CYCLE[SECURITY<br/>Bug Bounty / Vuln Research]
        VAULT[VAULT<br/>Crypto / DeFi / Trading]
        ATLAS[ATLAS<br/>OSINT / Threat Intel]
        ODYSSEY[ODYSSEY<br/>Content / Research / Writing]
    end

    %% EXECUTION LAYER
    subgraph EXEC ["Execution Layer"]
        direction TB
        WF[Workflows<br/>DAG-based Execution]
        EX[Executors<br/>Platform Adapters]
        PC[Platform Connectors<br/>HackerOne, Bugcrowd, GitHub, ...]
    end

    %% LEARNING LAYER
    subgraph LEARN ["Learning Layer"]
        direction TB
        FM[Feedback Loops<br/>Accept / Reject / Modify]
        RM[Reward Models<br/>EV Calibration]
        PL[Prompt Library<br/>Optimized Templates]
    end

    %% CONNECTIONS - HUMAN TO CORE
    H_DIR -->|Direction| EB
    H_APPR -->|Approval| ORCH
    H_FEED -->|Feedback| FM

    %% CONNECTIONS - CORE INTERNAL
    EB <--> SC
    EB <--> UM
    EB <--> SL
    EB <--> CFG

    %% CONNECTIONS - CORE TO INTELLIGENCE
    EB --> MERLIN
    EB --> EVOL
    EB --> RECOVERY
    EB --> KM

    UM --> MERLIN
    UM --> EVOL
    UM --> KM

    %% CONNECTIONS - INTELLIGENCE TO DEPTS
    MERLIN --> ORCH
    EVOL --> ORCH
    RECOVERY --> ORCH

    %% CONNECTIONS - DEPTS TO CYCLES
    ORCH --> FORGE
    ORCH --> PULSE
    ORCH --> SEC_CYCLE
    ORCH --> VAULT
    ORCH --> ATLAS
    ORCH --> ODYSSEY

    ENG --> FORGE
    ENG --> ODYSSEY
    QUA --> FORGE
    QUA --> PULSE
    SEC --> SEC_CYCLE
    SEC --> ATLAS
    REV --> VAULT
    REV --> FORGE

    %% CONNECTIONS - CYCLES TO EXECUTION
    FORGE --> WF
    PULSE --> WF
    SEC_CYCLE --> WF
    VAULT --> WF
    ATLAS --> WF
    ODYSSEY --> WF

    WF --> EX
    EX --> PC

    %% CONNECTIONS - EXECUTION TO LEARNING
    EX --> KM
    PC --> KM

    KM --> FM
    FM --> RM
    RM --> EVOL
    EVOL --> PL
    PL --> MERLIN

    %% STYLING
    classDef human fill:#000000,stroke:#2e2e2e,stroke-width:2px,color:#f5f5f5
    classDef core fill:#0a0a0a,stroke:#2e2e2e,stroke-width:2px,color:#f5f5f5
    classDef intel fill:#141414,stroke:#16a34a,stroke-width:2px,color:#f5f5f5
    classDef dept fill:#141414,stroke:#d97706,stroke-width:2px,color:#f5f5f5
    classDef cycle fill:#1f1f1f,stroke:#2e2e2e,stroke-width:1.5px,color:#f5f5f5
    classDef exec fill:#0a0a0a,stroke:#e82127,stroke-width:2px,color:#f5f5f5
    classDef learn fill:#141414,stroke:#16a34a,stroke-width:1.5px,color:#f5f5f5

    class H_DIR,H_APPR,H_FEED human
    class EB,SC,UM,SL,CFG core
    class MERLIN,EVOL,RECOVERY,KM intel
    class ORCH,ENG,QUA,SEC,REV dept
    class FORGE,PULSE,SEC_CYCLE,VAULT,ATLAS,ODYSSEY cycle
    class WF,EX,PC exec
    class FM,RM,PL learn