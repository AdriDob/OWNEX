{
  "name": "OWNEX Design Tokens",
  "version": "3.0",
  "description": "Design tokens for OWNEX brand identity v3 — 'The Aperture Nexus'. Base black/white/premium grays, electric blue intelligence, emerald progress, decision orange. Single source of truth for the branding pipeline.",
  "color_system": {
    "space_black": {
      "hex": "#05060A",
      "role": "base background"
    },
    "cyber_cyan": {
      "hex": "#00D5FF",
      "role": "intelligence accent"
    },
    "deep_blue": {
      "hex": "#1E40FF",
      "role": "intelligence accent"
    },
    "emerald": {
      "hex": "#00E39A",
      "role": "progress accent"
    },
    "decision": {
      "hex": "#FF7A1A",
      "role": "decision accent"
    },
    "surface": {
      "hex": "#111318",
      "role": "surface"
    },
    "surface_alt": {
      "hex": "#1F2229",
      "role": "surface alt"
    },
    "stroke": {
      "hex": "#2A2E37",
      "role": "border/stroke"
    },
    "white": {
      "hex": "#FFFFFF",
      "role": "on-black text"
    },
    "muted": {
      "hex": "#8B8D98",
      "role": "secondary text"
    },
    "text": {
      "hex": "#F6F8FB",
      "role": "primary text"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "'Space Grotesk', 'Inter', system-ui, -apple-system, sans-serif",
      "body": "'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "scale": {
      "h1": {
        "size": "64px",
        "weight": 700,
        "lineHeight": 1.1,
        "letterSpacing": "-0.03em"
      },
      "h2": {
        "size": "48px",
        "weight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em"
      },
      "h3": {
        "size": "36px",
        "weight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em"
      },
      "h4": {
        "size": "24px",
        "weight": 500,
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em"
      },
      "body": {
        "size": "16px",
        "weight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "small": {
        "size": "14px",
        "weight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "caption": {
        "size": "12px",
        "weight": 400,
        "lineHeight": 1.4,
        "letterSpacing": "0"
      }
    }
  },
  "spacing": {
    "unit": 8,
    "scale": {
      "1": 4,
      "2": 8,
      "3": 16,
      "4": 24,
      "5": 32,
      "6": 48,
      "8": 64,
      "10": 96,
      "12": 128
    }
  },
  "layout": {
    "containerMaxWidth": 1200,
    "sectionPadding": 96,
    "gridBase": 8
  },
  "components": {
    "missionControl": {
      "background": "#05060A",
      "surface": "#111318",
      "accent": "#00D5FF",
      "decision": "#FF7A1A",
      "text": "#F6F8FB"
    },
    "merlin": {
      "background": "#05060A",
      "surface": "#111318",
      "accent": "#00E39A",
      "text": "#F6F8FB"
    },
    "agentFleet": {
      "background": "#05060A",
      "surface": "#111318",
      "accent": "#1E40FF",
      "text": "#F6F8FB"
    }
  }
}
