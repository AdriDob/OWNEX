{
  "name": "OWNEX Design Tokens",
  "version": "2.0",
  "description": "Design tokens for OWNEX premium brand identity",
  "colors": {
    "cosmos": "#08090A",
    "surface": "#111113",
    "surfaceAlt": "#1F2023",
    "surfaceHighlight": "#2A2D35",
    "textPrimary": "#F6F8FB",
    "textSecondary": "#8B8D98",
    "textTertiary": "#5E6272",
    "accent": "#5E6AD2",
    "accentHover": "#7B85E0",
    "accentSubtle": "rgba(94, 106, 210, 0.15)",
    "success": "#00E39A",
    "warning": "#FFB020",
    "error": "#FF5252",
    "white": "#FFFFFF",
    "black": "#000000"
  },
  "typography": {
    "fontFamily": {
      "display": "'Inter Display', 'Inter', system-ui, -apple-system, sans-serif",
      "body": "'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "scale": {
      "h1": {
        "size": "64px",
        "weight": 700,
        "lineHeight": 1.1,
        "letterSpacing": "-0.03em"
      },
      "h2": {
        "size": "48px",
        "weight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em"
      },
      "h3": {
        "size": "36px",
        "weight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "-0.02em"
      },
      "h4": {
        "size": "24px",
        "weight": 500,
        "lineHeight": 1.3,
        "letterSpacing": "-0.01em"
      },
      "body": {
        "size": "16px",
        "weight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "small": {
        "size": "14px",
        "weight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "caption": {
        "size": "12px",
        "weight": 400,
        "lineHeight": 1.4,
        "letterSpacing": "0"
      }
    }
  },
  "spacing": {
    "unit": 8,
    "scale": {
      "1": 4,
      "2": 8,
      "3": 16,
      "4": 24,
      "5": 32,
      "6": 48,
      "8": 64,
      "10": 96,
      "12": 128
    }
  },
  "layout": {
    "containerMaxWidth": 1200,
    "sectionPadding": 96,
    "gridBase": 8
  },
  "components": {
    "missionControl": {
      "background": "#08090A",
      "surface": "#111113",
      "accent": "#5E6AD2",
      "text": "#F6F8FB"
    },
    "merlin": {
      "background": "#08090A",
      "surface": "#111113",
      "accent": "#00E39A",
      "text": "#F6F8FB"
    },
    "agentFleet": {
      "background": "#08090A",
      "surface": "#111113",
      "accent": "#5E6AD2",
      "text": "#F6F8FB"
    }
  }
}
