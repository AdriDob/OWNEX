      "rules": {
        "*.{md,mdx}": {
          "loaders": [
            {
              "loader": "fumadocs-mdx/webpack/mdx",
              "options": {
                "configPath": "source.config.ts",
                "outDir": ".source",
                "absoluteCompiledConfigPath": "./.source/source.config.mjs",
                "isDev": false
              }
            }
          ],
          "as": "*.js"
        },
        "*.json": {
          "condition": {
            "query": {}
          },
          "loaders": [
            {
              "loader": "fumadocs-mdx/webpack/meta",
              "options": {
                "configPath": "source.config.ts",
                "outDir": ".source",
                "absoluteCompiledConfigPath": "./.source/source.config.mjs",
                "isDev": false
              }
            }
          ],
          "as": "*.json"
        },
        "*.yaml": {
          "condition": {
            "query": {}
          },
          "loaders": [
            {
              "loader": "fumadocs-mdx/webpack/meta",
              "options": {
                "configPath": "source.config.ts",
                "outDir": ".source",
                "absoluteCompiledConfigPath": "./.source/source.config.mjs",
                "isDev": false
              }
            }
          ],
          "as": "*.js"
        }
      }
