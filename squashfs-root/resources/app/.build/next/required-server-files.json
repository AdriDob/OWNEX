{
  "version": 1,
  "config": {
    "env": {},
    "typescript": {
      "ignoreBuildErrors": true
    },
    "typedRoutes": false,
    "distDir": ".build/next",
    "cleanDistDir": true,
    "assetPrefix": "",
    "cacheMaxMemorySize": 52428800,
    "configOrigin": "next.config.mjs",
    "useFileSystemPublicRoutes": true,
    "generateEtags": true,
    "pageExtensions": [
      "mdx",
      "md",
      "jsx",
      "js",
      "tsx",
      "ts"
