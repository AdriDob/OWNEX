[run]
source =
    api
    core
    cores
omit = 
    */tests/*
    */migrations/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if DEBUG
    if TYPE_CHECKING
    if TYPE_CHECKING:
ignore_errors = True
skip_covered = False
show_missing = True
skip_empty = False
precision = 2

# Coverage ratchet: measured baseline 2026-11-23 is ~39.5% (ci.yml subset)
# and ~45.2% (test.yml subset) — the 80% goal remains open. This floor only
# prevents regression; raise it as real coverage grows. Do NOT inflate it
# without measured evidence.
fail_under = 39

[report:core/revenue]
# Revenue code is mission-critical for FASE -1 - require higher coverage
fail_under = 90

[report:core/revenue/economic_memory.py]
# EconomicMemory is core to FASE -1 - require near-perfect coverage
fail_under = 95

[report:core/revenue/metrics.py]
# RevenueMetrics is core to FASE -1 - require near-perfect coverage
fail_under = 95

[html]
directory = htmlcov