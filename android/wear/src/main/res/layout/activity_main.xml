<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ORION WATCH"
            android:textColor="#00D5FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Loading..."
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:padding="6dp"
            android:background="#1a1a1a" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NOTIFICATIONS"
            android:textColor="#FF7A1A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/notifications_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No notifications"
            android:textColor="#CCCCCC"
            android:textSize="10sp"
            android:padding="6dp"
            android:background="#1a1a1a" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DAILY INCOME"
            android:textColor="#00E39A"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/earnings_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No data"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:padding="6dp"
            android:background="#1a1a1a" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <Button
                android:id="@+id/btn_refresh"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="↻"
                android:textSize="16sp"
                android:background="#1a1a1a"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_approve"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="✓"
                android:textSize="16sp"
                android:background="#00E39A"
                android:textColor="#000000"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/btn_theme"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🎨"
                android:textSize="16sp"
                android:background="#1a1a1a"
                android:textColor="#FFFFFF"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/theme_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tema: Emerald"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:gravity="center"
            android:paddingTop="6dp" />

    </LinearLayout>
</ScrollView>
