<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0a0a1a">

    <!-- System Status -->
    <TextView
        android:id="@+id/system_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 ORION Online"
        android:textColor="#00ff88"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Workflows Count -->
    <TextView
        android:id="@+id/workflows_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3 Workflows"
        android:textColor="#ffffff"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Approvals Count -->
    <TextView
        android:id="@+id/approvals_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2 Approvals"
        android:textColor="#00f0ff"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#00f0ff"
        android:alpha="0.3"
        android:layout_marginBottom="16dp"/>

    <!-- Notification/Approval Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="rgba(0, 240, 255, 0.1)"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:textSize="24sp"
            android:contentDescription="Notification icon"/>

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finding Detected"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/notification_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SQL injection in target"
            android:textColor="#cccccc"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginTop="4dp"/>

        <!-- Approval Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center">

            <Button
                android:id="@+id/btn_approve"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✓"
                android:textColor="#000000"
                android:background="#00ff88"
                android:layout_marginEnd="8dp"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btn_reject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="✗"
                android:textColor="#ffffff"
                android:background="#ff6b35"
                android:layout_marginStart="8dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#00f0ff"
        android:alpha="0.3"
        android:layout_marginBottom="16dp"/>

    <!-- MERLIN Summary -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧙 MERLIN Summary"
        android:textColor="#00f0ff"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/merlin_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2 opportunities detected today"
        android:textColor="#ffffff"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

</LinearLayout>
