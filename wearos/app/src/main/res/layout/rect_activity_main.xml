<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0a0a1a">

    <!-- System Status -->
    <TextView
        android:id="@+id/system_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 ORION Online"
        android:textColor="#00ff88"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Tasks Count -->
    <TextView
        android:id="@+id/tasks_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="5 Tasks"
        android:textColor="#ffffff"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Habits Count -->
    <TextView
        android:id="@+id/habits_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3 Habits"
        android:textColor="#00f0ff"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#00f0ff"
        android:alpha="0.3"
        android:layout_marginBottom="16dp"/>

    <!-- Current Mood -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="😊 Today's Mood"
        android:textColor="#00f0ff"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/current_mood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="😊"
        android:textColor="#ffffff"
        android:textSize="24sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#00f0ff"
        android:alpha="0.3"
        android:layout_marginBottom="16dp"/>

    <!-- Refresh Button -->
    <Button
        android:id="@+id/btn_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Refresh"
        android:textColor="#000000"
        android:background="#00f0ff"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- Logout Button -->
    <Button
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textColor="#ffffff"
        android:background="#ff6b35"
        android:layout_marginTop="12dp"
        android:visibility="gone"/>

</LinearLayout>
